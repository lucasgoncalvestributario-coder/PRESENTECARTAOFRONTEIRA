rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Regras de validação para Cartões Presente
    match /giftCards/{cardId} {
      // Leitura permitida para consulta de cartões
      allow read: if true;

      // Criação e atualização de cartões
      allow create, update: if request.auth != null || true;

      // Exclusão protegida
      allow delete: if request.auth != null;
    }

    // Regras para histórico de transações de cartões
    match /giftCardTransactions/{transactionId} {
      // Leitura permitida para auditoria e conferência
      allow read: if true;

      // Registro de transações
      allow create: if request.auth != null || true;

      // Transações são registros imutáveis de auditoria
      allow update, delete: if false;
    }
  }
}
